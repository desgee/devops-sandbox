# devops-sandbox — environment variables
# Copy to .env before running: cp .env.example .env
# NEVER commit .env to version control.

# ── Core ports ────────────────────────────────────────────────────────────────
NGINX_PORT=8080
API_PORT=7000

# ── Sandbox env port range ────────────────────────────────────────────────────
# Each created environment gets a random port in this range
ENV_PORT_MIN=8100
ENV_PORT_MAX=9000

# ── Optional: Netdata monitoring (docker-compose.monitoring.yml) ──────────────
NETDATA_PORT=19999

# ── Cleanup daemon ────────────────────────────────────────────────────────────
# How often the daemon checks TTLs (seconds). Default: 60
CLEANUP_INTERVAL=60

# ── Health monitor ────────────────────────────────────────────────────────────
# How often to poll /health endpoints (seconds). Default: 30
HEALTH_POLL_INTERVAL=30
# Consecutive failures before marking env "degraded". Default: 3
HEALTH_DEGRADED_THRESHOLD=3
